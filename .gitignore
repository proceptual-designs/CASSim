# Environments (in-project uv venv)
.venv/
.env
.env.*

# Python / tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/

# Build output (Flet static sites, wheels, vendored Pyodide packages)
dist/
build/
/builds/
*.egg-info/
.flet/

# Browser test output
node_modules/
playwright-report/
test-results/

# Third-party reference material: copyrighted (TI, VCE publishers) or licence not yet
# checked (LazyMath UDFs). Kept locally and backed up by OneDrive; never committed.
/references/

# Local-only editor/agent settings and OS/Office junk
.claude/settings.local.json
.vscode/
Thumbs.db
desktop.ini
.DS_Store
~$*
*.log

# Makers' keypad/layout screenshots, one folder per device (docs/design/README.md):
# copyrighted design input, kept locally only. Each folder's README.md is committed.
docs/design/reference/**/*.png
docs/design/reference/**/*.jpg
docs/design/reference/**/*.jpeg

# Simulator screenshots and capture briefs live in the separate evidence repository
# (decision 0039, tools/evidence.py). docs/testing/app-shots/ shows CASSim itself and stays.
/corpus/shots/
/docs/testing/*-shots/
/docs/testing/*-shots-*/
!/docs/testing/app-shots/
/docs/testing/emulator-*-capture.md
/docs/testing/*-remaining.md
/docs/testing/*-brief.md
/docs/testing/*-plan.md
/docs/testing/simulator-todo.md

# Generated by spikes/make_cassim_zip.py
cassim.zip

# Safety net: secrets and keys (anything credential-like stays out of the repo)
*.pem
*.key
*.pfx
*.p12
*.crt
*.pub
id_rsa*
id_ed25519*
secrets.*
*secret*.json
*credential*
.netrc
.npmrc
.pypirc

# Safety net: TI/VCAA material that must never be committed (decision 0012, CLAUDE.md)
*.tns
*.tco
*.tcc
*.pdf

