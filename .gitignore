# Environments (in-project uv venv)
.venv/
.env
.env.*

# Python / tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build output (Flet static sites, wheels, vendored Pyodide packages)
dist/
build/
/builds/
*.egg-info/
.flet/

# Browser test output
node_modules/
playwright-report/
test-results/

# Third-party reference material: copyrighted (TI, VCE publishers) or licence not yet
# checked (LazyMath UDFs). Kept locally and backed up by OneDrive; never committed.
/references/

# Local-only editor/agent settings and OS/Office junk
.claude/settings.local.json
.vscode/
Thumbs.db
desktop.ini
.DS_Store
~$*
*.log

# TI keypad/layout screenshots: copyrighted design input, kept locally only.
docs/design/reference/*.png

# Generated by spikes/make_cassim_zip.py
cassim.zip

# Safety net: secrets and keys (anything credential-like stays out of the repo)
*.pem
*.key
*.pfx
*.p12
*.crt
*.pub
id_rsa*
id_ed25519*
secrets.*
*secret*.json
*credential*
.netrc
.npmrc
.pypirc

# Safety net: TI/VCAA material that must never be committed (decision 0012, CLAUDE.md)
*.tns
*.tco
*.tcc
*.pdf

# Safety net: other tool caches, editors and scratch files
.mypy_cache/
.ty_cache/
.ty/
.idea/
.vs/
*.swp
*.swo
*~
*.bak
*.orig
