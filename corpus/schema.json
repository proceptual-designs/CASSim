{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CASSim golden corpus file",
  "type": "object",
  "required": [
    "schema_version",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "app_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/app_case"
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "angle": {
          "enum": [
            "radian",
            "degree",
            "gradian"
          ]
        },
        "calc": {
          "enum": [
            "auto",
            "exact",
            "approximate"
          ]
        },
        "domain": {
          "enum": [
            "real",
            "rectangular",
            "polar"
          ]
        },
        "digits": {
          "type": "string",
          "pattern": "^(float|fix)[0-9]{1,2}$"
        },
        "cas_mode": {
          "enum": [
            "on",
            "exact_arithmetic",
            "off"
          ],
          "default": "on",
          "description": "Document Settings > CAS Mode"
        },
        "exp_format": {
          "enum": [
            "normal",
            "scientific",
            "engineering"
          ],
          "description": "Exponential Format in Document Settings (default normal)."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "string",
          "description": "One calculator entry line, TI syntax, ASCII-friendly"
        },
        "out": {
          "type": "string",
          "description": "Expected result in TI-style text; parsed and compared per `compare`"
        },
        "error": {
          "type": "boolean",
          "description": "Entry is expected to produce an error"
        },
        "error_contains": {
          "type": "string"
        },
        "compare": {
          "enum": [
            "canonical",
            "numeric",
            "text",
            "family",
            "ignore"
          ],
          "default": "canonical"
        },
        "tol": {
          "type": "number",
          "description": "Relative tolerance for compare=numeric"
        },
        "new_problem": {
          "type": "boolean",
          "description": "Insert a new Problem before this step (variables cleared)"
        },
        "set": {
          "$ref": "#/$defs/settings",
          "description": "Change document settings before this step"
        },
        "note": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "in",
            "out"
          ]
        },
        {
          "required": [
            "in",
            "error"
          ]
        },
        {
          "required": [
            "new_problem"
          ]
        },
        {
          "required": [
            "set"
          ]
        }
      ]
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "course",
        "steps",
        "provenance",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "course": {
          "enum": [
            "methods",
            "specialist",
            "general",
            "none"
          ]
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tier": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "third_party": {
          "type": "boolean",
          "description": "The entries come from third-party material, such as a VCAA exam (decision 0012)"
        },
        "source": {
          "type": "string",
          "description": "Where third-party entries come from, with the copyright holder"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "simulator",
                "skill_notes",
                "hand_computed",
                "unverified_expectation"
              ]
            },
            "simulator_version": {
              "type": "string"
            },
            "captured": {
              "type": "string"
            },
            "evidence": {
              "description": "Screenshot path(s) under corpus/shots/",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            },
            "reviewed_by": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "status": {
          "enum": [
            "pass",
            "xfail",
            "pending"
          ],
          "description": "pending = not yet runnable by the engine"
        },
        "xfail_reason": {
          "type": "string"
        }
      }
    },
    "app_case": {
      "type": "object",
      "required": [
        "id",
        "app",
        "course",
        "setup",
        "checks",
        "provenance",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "app": {
          "enum": [
            "spreadsheet",
            "graphs",
            "data-statistics"
          ]
        },
        "course": {
          "enum": [
            "methods",
            "specialist",
            "general",
            "none"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "setup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Ordered UI-level actions that reproduce the state (menu paths, typed entries)."
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "what",
              "expect"
            ],
            "additionalProperties": false,
            "properties": {
              "what": {
                "type": "string"
              },
              "expect": {},
              "tol": {
                "type": "number"
              },
              "compare": {
                "enum": [
                  "numeric",
                  "text",
                  "list"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "simulator",
                "skill_notes",
                "hand_computed",
                "unverified_expectation"
              ]
            },
            "simulator_version": {
              "type": "string"
            },
            "captured": {
              "type": "string"
            },
            "evidence": {
              "description": "Screenshot path(s) under corpus/shots/",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            },
            "reviewed_by": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "status": {
          "enum": [
            "pass",
            "xfail",
            "pending"
          ],
          "description": "pending = not yet runnable by the engine"
        }
      }
    }
  }
}